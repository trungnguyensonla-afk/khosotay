# Sao chép file này thành ".env" và điền giá trị thật. KHÔNG commit file ".env" vào git.

# Chuỗi kết nối PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<ten_database>
DATABASE_URL=postgresql+psycopg2://khosotay_app:doi_mat_khau_nay@localhost:5432/khosotay_db

# Khóa bí mật Flask dùng để ký session - đặt chuỗi ngẫu nhiên dài, giữ bí mật
SECRET_KEY=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-va-bi-mat

# Thư mục lưu file gốc tài liệu đã nạp
UPLOAD_DIR=data/files

# Đường dẫn tới thư mục bin của Poppler (bắt buộc cho pdf2image trên Windows)
# Tìm bằng lệnh: where pdftoppm  (sau khi cài qua winget install oschwartz10612.Poppler)
POPPLER_PATH=C:\duong-dan-toi-poppler\Library\bin

# Đường dẫn file thực thi Tesseract (tìm bằng lệnh: where tesseract)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Đường dẫn pg_dump.exe (dùng cho chức năng sao lưu database), thường cùng thư mục với psql.exe
PG_DUMP_CMD=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
